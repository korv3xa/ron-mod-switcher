<Window x:Class="RoNModSwitcher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="RoN Mod Switcher — Vosien Studio"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="1140"
        Height="760"
        MinWidth="920"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#090807">
    <Grid Background="#090807">
        <wv2:WebView2 x:Name="WebView"
                      DefaultBackgroundColor="#FF090807" />

        <Border x:Name="FallbackPanel"
                Visibility="Collapsed"
                Background="#090807"
                Padding="36">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        MaxWidth="520">
                <TextBlock Text="Microsoft Edge WebView2 Runtime Required"
                           Foreground="#F8FAFC"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12" />
                <TextBlock x:Name="FallbackReasonText"
                           Text="RoN Mod Switcher requires the Microsoft Edge WebView2 Runtime to display its interface. Most Windows 10/11 systems include it by default."
                           Foreground="#94A3B8"
                           FontSize="14"
                           TextWrapping="Wrap"
                           Margin="0,0,0,22" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Download WebView2 Runtime"
                            Click="DownloadWebView2_Click"
                            Padding="18,10"
                            Background="#0EA5E9"
                            Foreground="#0B0F14"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Cursor="Hand" />
                    <Button Content="Join Discord Support"
                            Click="OpenDiscordSupport_Click"
                            Margin="12,0,0,0"
                            Padding="16,10"
                            Background="#1E293B"
                            Foreground="#E2E8F0"
                            BorderThickness="0"
                            Cursor="Hand" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
